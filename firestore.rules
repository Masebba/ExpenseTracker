rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(userId) { return signedIn() && request.auth.uid == userId; }
    function hasMembership(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(orgId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(orgId)).data.status == 'active';
    }
    function activeMember(orgId) { return hasMembership(orgId); }
    function role(orgId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(orgId)).data.role;
    }
    function canEdit(orgId) { return activeMember(orgId) && role(orgId) in ['owner', 'admin', 'editor']; }
    function canManage(orgId) { return activeMember(orgId) && role(orgId) in ['owner', 'admin']; }
    function isDeveloper() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.developerAdmin == true;
    }

    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId) && !('developerAdmin' in request.resource.data);
      allow update: if isUser(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['developerAdmin']);
      allow delete: if isUser(userId);
      match /{collectionName}/{document=**} {
        allow read, write: if collectionName != 'memberships' && isUser(userId);
      }
      match /memberships/{orgId} {
        allow read: if isUser(userId) || (signedIn() && hasMembership(orgId));
        allow create: if signedIn() && request.auth.token.email is string && request.resource.data.status == 'active'
          && request.resource.data.role in ['owner', 'admin', 'editor', 'viewer']
          && request.resource.data.organizationId == orgId
          && (isUser(userId)
            ? ((request.resource.data.role == 'owner' && request.resource.data.email == request.auth.token.email.lower() && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == userId)
              || (request.resource.data.email == request.auth.token.email.lower()
              && exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.auth.token.email.lower()))
              && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.auth.token.email.lower())).data.status == 'pending'
              && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.auth.token.email.lower())).data.role == request.resource.data.role))
            : (request.auth.uid == userId
              && exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.auth.token.email.lower()))
              && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.auth.token.email.lower())).data.status == 'pending'
              && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.auth.token.email.lower())).data.email == request.auth.token.email.lower()
              && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.auth.token.email.lower())).data.role == request.resource.data.role));
        allow update: if signedIn() && resource.data.role != 'owner'
          && activeMember(resource.data.organizationId) && role(resource.data.organizationId) == 'owner'
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt']);
        allow delete: if signedIn() && resource.data.role != 'owner'
          && ((request.auth.uid == userId)
            || (activeMember(resource.data.organizationId) && role(resource.data.organizationId) == 'owner'));
      }
    }

    match /organizations/{orgId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if activeMember(orgId);
      allow update: if activeMember(orgId) && role(orgId) == 'owner' && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if activeMember(orgId) && role(orgId) == 'owner';
      match /{collectionName}/{document=**} {
      allow read: if activeMember(orgId) && collectionName in ['transactions', 'products', 'sales', 'orders', 'productCategories', 'customers', 'suppliers', 'invoices', 'purchases'];
      allow create: if canEdit(orgId)
          && collectionName in ['transactions', 'products', 'sales', 'orders', 'productCategories', 'customers', 'suppliers', 'invoices', 'purchases']
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canEdit(orgId) && collectionName in ['transactions', 'products', 'sales', 'orders', 'productCategories', 'customers', 'suppliers', 'invoices', 'purchases'];
        allow delete: if canEdit(orgId) && collectionName in ['transactions', 'products', 'sales', 'orders', 'productCategories', 'customers', 'suppliers', 'invoices', 'purchases'];
      }
      match /invitations/{email} {
        allow read: if (signedIn() && request.auth.token.email is string && resource.data.email == request.auth.token.email.lower())
          || canManage(orgId);
        allow delete: if signedIn() && request.auth.token.email is string && resource.data.email == request.auth.token.email.lower();
        allow create, update: if canManage(orgId)
          && request.resource.data.organizationId == orgId
          && email == request.resource.data.email
          && request.resource.data.email is string
          && request.resource.data.role in ['admin', 'editor', 'viewer'];
      }
    }

    // Allows owners/admins to query memberships across user documents for their organisation.
    match /{path=**}/memberships/{membershipId} {
      allow list: if signedIn() && resource.data.organizationId is string
        && activeMember(resource.data.organizationId)
        && role(resource.data.organizationId) in ['owner', 'admin'];
    }

    // collectionGroup('invitations') requires a recursive collection-group rule.
    // It only allows a signed-in recipient to read their own normalized email invitations.
    match /{path=**}/invitations/{invitationId} {
      allow read: if signedIn() && request.auth.token.email is string
        && resource.data.email == request.auth.token.email.lower();
    }

    match /advertisements/{advertisementId} {
      allow read: if true;
      allow create: if isDeveloper()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.publisherType == 'developer';
      allow update, delete: if isDeveloper()
        && resource.data.createdBy == request.auth.uid
        && resource.data.publisherType == 'developer';
    }

    match /appContent/termsOfService {
      allow read: if true;
      allow create, update: if isDeveloper()
        && request.resource.data.keys().hasOnly(['body', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAll(['body', 'updatedAt', 'updatedBy'])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 20000
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
