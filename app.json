{
  "expo": {
    "name": "ExpenseTracker",
    "slug": "expense-tracker-masebba",
    "scheme": "expensetracker",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.masebba.ExpenseTracker",
      "versionCode": 2,
      "backgroundColor": "#ffffff",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e686eb7d-2e35-4e19-82e7-3d811f8a4cc1"
      }
    },
    "owner": "masebba",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID data."
        }
      ],
      "expo-sharing",
      "expo-document-picker"
    ],
    "runtimeVersion": "1.0.0",

    "updates": {
      "url": "https://u.expo.dev/e686eb7d-2e35-4e19-82e7-3d811f8a4cc1"
    }
  }
}
